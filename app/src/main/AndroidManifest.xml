<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:name=".KhataApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Khata"
        android:supportsRtl="true"
        android:theme="@style/Theme.Khata">
        <receiver
            android:name=".widget.KhataHomeWidgetProvider"
            android:exported="true"
            android:label="Khata · Today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_khata_info" />
        </receiver>
        <receiver android:name=".widget.KhataDailyWidgetProvider" android:exported="true" android:label="Khata · Daily total">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_daily_info" />
        </receiver>
        <receiver android:name=".widget.KhataWeeklyWidgetProvider" android:exported="true" android:label="Khata · Weekly total">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_weekly_info" />
        </receiver>
        <receiver android:name=".widget.KhataMonthlyWidgetProvider" android:exported="true" android:label="Khata · Monthly total">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_monthly_info" />
        </receiver>
        <receiver android:name=".widget.KhataAllTimeWidgetProvider" android:exported="true" android:label="Khata · All-time total">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_all_time_info" />
        </receiver>
        <receiver android:name=".widget.KhataProgressRingWidgetProvider" android:exported="true" android:label="Khata · Budget ring">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_progress_ring_info" />
        </receiver>
        <receiver android:name=".widget.KhataQuoteWidgetProvider" android:exported="true" android:label="Khata · Quote">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quote_info" />
        </receiver>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
