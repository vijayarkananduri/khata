<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ring_card" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:layout_width="94dp" android:layout_height="94dp">
            <ImageView android:id="@+id/widget_ring_image" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Monthly budget progress"/>
            <TextView android:id="@+id/widget_ring_percent" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="—" android:textColor="#FF28231E" android:textSize="18sp" android:textStyle="bold"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/widget_ring_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THIS MONTH" android:textColor="#FF76462F" android:textSize="10sp" android:letterSpacing="0.1" android:textStyle="bold"/>
            <TextView android:id="@+id/widget_ring_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="₹0" android:textColor="#FF28231E" android:textSize="24sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_ring_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Set a monthly budget in Khata" android:textColor="#FF554C43" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
