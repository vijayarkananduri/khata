<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Khata: private, offline money tracker for Android</title>
<meta name="description" content="Khata is a private, offline money tracker for Android. No bank linking, no sign-up, no cloud.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#FBF3E4;--bg2:#F3E2C4;--ink:#2B1D14;--muted:#6E5847;
  --turmeric:#E3A21A;--chili:#B8432A;--jaggery:#8A5A2B;
  --glass:rgba(255,250,240,.6);--edge:rgba(255,255,255,.75);--shadow:rgba(120,70,20,.18);
  --sans:"Google Sans","Product Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --hand:"Caveat","Segoe Script",cursive;
}
[data-theme="dark"]{
  --bg:#17110D;--bg2:#241A13;--ink:#F6E9D6;--muted:#BBA48B;
  --glass:rgba(60,42,30,.55);--edge:rgba(255,226,180,.16);--shadow:rgba(0,0,0,.5);
}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:var(--sans);color:var(--ink);background:var(--bg);line-height:1.6;overflow-x:hidden;transition:background-color .3s,color .3s}
body::before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;
  background:
   radial-gradient(60vmax 50vmax at 5% 0%,rgba(227,162,26,.35),transparent 70%),
   radial-gradient(55vmax 45vmax at 100% 35%,rgba(184,67,42,.22),transparent 70%),
   radial-gradient(60vmax 50vmax at 20% 100%,rgba(138,90,43,.25),transparent 70%)}
a{color:inherit}
img{max-width:100%}
.wrap{max-width:1080px;margin:0 auto;padding:0 18px}
.glass{background:var(--glass);-webkit-backdrop-filter:blur(18px) saturate(1.5);backdrop-filter:blur(18px) saturate(1.5);
  border:1px solid var(--edge);box-shadow:inset 0 1px 0 var(--edge),0 12px 32px var(--shadow);border-radius:24px}
:focus-visible{outline:3px solid var(--chili);outline-offset:3px}

/* nav */
nav{position:sticky;top:10px;z-index:10;padding:10px 14px 0}
nav .glass{max-width:1080px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:8px 8px 8px 18px;border-radius:999px}
.logo{font-weight:700;font-size:1.15rem;text-decoration:none}
.nav-r{display:flex;align-items:center;gap:4px}
.nav-r a.l{display:none;padding:8px 12px;text-decoration:none;color:var(--muted);font-size:.95rem}
button.theme{font:inherit;font-size:.9rem;cursor:pointer;color:var(--ink);padding:9px 16px;border-radius:999px;background:transparent;border:1px solid var(--edge)}

/* buttons */
.btn{display:block;text-align:center;font-weight:500;text-decoration:none;padding:15px 24px;border-radius:999px}
.btn.main{background:linear-gradient(135deg,var(--turmeric),var(--chili));color:#fff;box-shadow:0 10px 24px rgba(184,67,42,.35)}
.btn.alt{border:1px solid var(--edge);background:var(--glass);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
.cta{display:grid;gap:10px}

/* hero */
.hero{display:grid;gap:34px;padding:34px 0 24px}
.hand{font-family:var(--hand);font-size:1.6rem;line-height:1.1;color:var(--chili);display:block;margin-bottom:8px}
[data-theme="dark"] .hand{color:var(--turmeric)}
h1{font-size:clamp(2.3rem,10vw,4.4rem);line-height:1.06;letter-spacing:-.02em}
.sub{font-size:1.05rem;color:var(--muted);margin:16px 0 24px;max-width:32em}
.phone{justify-self:center;width:min(250px,70vw);padding:8px;border-radius:38px}

/* images */
.pic{display:block;width:100%;aspect-ratio:9/19.5;object-fit:cover;border-radius:30px;background:var(--bg2);color:var(--muted);font-size:.8rem;text-align:center}

/* marquee */
.mq{overflow:hidden;padding:14px 0;margin:14px 0}
.marquee{white-space:nowrap;padding:10px 0;border-block:1px solid var(--edge);background:var(--glass);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);transform:rotate(-1.2deg) scale(1.03)}
.track{display:inline-flex;animation:scroll 30s linear infinite}
.track span{font-family:var(--hand);font-size:1.9rem;font-weight:700;padding:0 24px;color:var(--jaggery)}
[data-theme="dark"] .track span{color:var(--turmeric)}
.track span::after{content:"/";margin-left:48px;color:var(--chili);opacity:.7}
@keyframes scroll{to{transform:translateX(-50%)}}

/* sections */
section{padding:42px 0}
h2{font-size:clamp(1.7rem,7vw,2.6rem);line-height:1.15;letter-spacing:-.015em;margin-bottom:10px}
.lead{color:var(--muted);max-width:36em;margin-bottom:24px}

.shots{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;margin:0 -18px;padding:6px 18px 22px;scrollbar-width:none}
.shots::-webkit-scrollbar{display:none}
.shot{flex:0 0 66%;scroll-snap-align:center;padding:7px;border-radius:28px}
.shot .pic{border-radius:22px}
.shot figcaption{font-family:var(--hand);font-size:1.4rem;text-align:center;padding:6px 0 2px}

.grid{display:grid;gap:14px}
.card{padding:22px}
.card h3{font-size:1.15rem;margin-bottom:6px}
.card p,.card li{color:var(--muted);font-size:.98rem}
.card ul{margin:8px 0 0 18px}
.card li{margin:5px 0}
.note{margin-top:14px;padding:10px 14px;border-left:3px solid var(--turmeric);border-radius:6px;font-family:var(--hand);font-size:1.3rem;line-height:1.25;background:rgba(227,162,26,.13)}
.final{text-align:center;padding:36px 20px;margin:10px 0 40px}
.final p{color:var(--muted);margin:6px auto 22px;max-width:30em}
footer{padding:20px 18px 44px;text-align:center;color:var(--muted);font-size:.92rem}
footer a{display:inline-block;margin:4px 10px}

/* tablet and up */
@media(min-width:760px){
  .wrap{padding:0 26px}
  .nav-r a.l{display:inline-block}
  .btn{display:inline-block}
  .cta{display:flex;gap:12px}
  .hero{grid-template-columns:1.1fr .9fr;align-items:center;gap:40px;padding:70px 0 40px}
  .phone{width:min(290px,100%);transform:rotate(3deg)}
  .hand{font-size:1.8rem}
  section{padding:60px 0}
  .shots{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;overflow:visible;margin:0;padding:0}
  .shot:nth-child(even){margin-top:30px}
  .grid{grid-template-columns:repeat(3,1fr);gap:20px}
  .card.wide{grid-column:span 2}
  .grid.two{grid-template-columns:1fr 1fr}
  .final{padding:50px 24px;margin-bottom:60px}
}
@media(hover:hover){.btn:hover{transform:translateY(-2px)}.marquee:hover .track{animation-play-state:paused}}
@media(prefers-reduced-motion:reduce){.track{animation:none}.mq{overflow-x:auto}html{scroll-behavior:auto}}
</style>
</head>
<body>

<nav><div class="glass">
  <a class="logo" href="#top">Khata</a>
  <div class="nav-r">
    <a class="l" href="#shots">Screens</a>
    <a class="l" href="#features">Features</a>
    <a class="l" href="https://github.com/vijayarkananduri/khata">GitHub</a>
    <button class="theme" id="theme" aria-label="Switch between light and dark theme">Dark</button>
  </div>
</div></nav>

<main class="wrap" id="top">
  <div class="hero">
    <div>
      <span class="hand">the old ledger, now in your pocket</span>
      <h1>Your money. Your phone. Nobody else.</h1>
      <p class="sub">Khata is a private, offline money tracker for Android. No bank linking, no sign-up, no cloud. You write the entries, the app keeps them, and nobody gets a copy.</p>
      <div class="cta">
        <a class="btn main" href="https://github.com/vijayarkananduri/khata/releases/latest">Download the APK</a>
        <a class="btn alt" href="https://github.com/vijayarkananduri/khata">View on GitHub</a>
      </div>
    </div>
    <div class="phone glass"><img class="pic" data-n="home" alt="Khata home screen"></div>
  </div>
</main>

<div class="mq" aria-hidden="true"><div class="marquee"><div class="track">
  <span>no bank linking</span><span>works fully offline</span><span>no account needed</span><span>your data stays on your phone</span><span>nudges before you run out</span><span>five Indian languages</span>
  <span>no bank linking</span><span>works fully offline</span><span>no account needed</span><span>your data stays on your phone</span><span>nudges before you run out</span><span>five Indian languages</span>
</div></div></div>

<main class="wrap">
  <section id="shots">
    <h2>See where your money went</h2>
    <p class="lead">Four screens, nothing hidden. Swipe through them.</p>
    <div class="shots">
      <figure class="shot glass"><img class="pic" data-n="home" alt="Home screen"><figcaption>home</figcaption></figure>
      <figure class="shot glass"><img class="pic" data-n="calender,calendar" alt="Calendar and heatmap"><figcaption>calendar</figcaption></figure>
      <figure class="shot glass"><img class="pic" data-n="widjet,widget" alt="Home-screen widgets"><figcaption>widgets</figcaption></figure>
      <figure class="shot glass"><img class="pic" data-n="settings" alt="Settings"><figcaption>settings</figcaption></figure>
    </div>
  </section>

  <section id="features">
    <h2>It tracks. That is the whole job.</h2>
    <p class="lead">Khata does a few things and does them quietly.</p>
    <div class="grid">
      <div class="card glass wide">
        <h3>Nudges before you run out</h3>
        <p>Once Khata has seen you buy the same thing more than twice, it works out how often you buy it and reminds you when the next one is due. Milk, groceries, petrol, essentials. The maths happens on your phone, and you can switch nudges off in Settings.</p>
        <div class="note">A litre of milk lasts two days. On day two: "You may be running out of milk."</div>
      </div>
      <div class="card glass"><h3>Heatmap of your year</h3><p>A GitHub-style grid of your spending. Dark squares are the days your wallet had opinions.</p></div>
      <div class="card glass"><h3>Home-screen widgets</h3><p>Daily, weekly, monthly or all-time totals, and budget progress, without opening the app.</p></div>
      <div class="card glass"><h3>Your language</h3><p>Hindi, Telugu, Tamil, Malayalam and Kannada, in the original script or in English letters.</p></div>
      <div class="card glass"><h3>A bit of personality</h3><p>Short quotes inspired by movies and memes, because tracking money should not feel like a tax audit.</p></div>
      <div class="card glass"><h3>Matches your phone</h3><p>Light, Dark, System, or colours pulled from your wallpaper. Export everything as CSV any time.</p></div>
    </div>
  </section>

  <section>
    <div class="grid two">
      <div class="card glass"><h3>Khata is for you if</h3><ul>
        <li>You think your bank statement is none of an app's business</li>
        <li>You are happy to type in your own spending</li>
        <li>You want to see where money went, not be told how to invest it</li></ul></div>
      <div class="card glass"><h3>Khata is not for you if</h3><ul>
        <li>You want expenses to appear automatically from your bank</li>
        <li>You want AI forecasts, scores or smart insights</li></ul></div>
    </div>
  </section>

  <div class="final glass">
    <h2>Open the book.</h2>
    <p>Install the APK, allow installs from your browser if Android asks, and start writing.</p>
    <a class="btn main" href="https://github.com/vijayarkananduri/khata/releases/latest">Download the latest APK</a>
  </div>
</main>

<footer>
  <a href="https://github.com/vijayarkananduri/khata">Source code</a>
  <a href="https://github.com/vijayarkananduri/khata/releases">Releases</a>
  <a href="https://github.com/vijayarkananduri/khata/issues">Report a bug</a>
  <p style="margin-top:10px">Built with Kotlin, Jetpack Compose and Room.</p>
</footer>

<script>
(function(){
  var root=document.documentElement,btn=document.getElementById('theme'),saved=null;
  try{saved=localStorage.getItem('khata-theme')}catch(e){}
  var theme=saved||(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');
  function apply(t){root.setAttribute('data-theme',t);btn.textContent=t==='dark'?'Light':'Dark'}
  apply(theme);
  btn.addEventListener('click',function(){
    theme=theme==='dark'?'light':'dark';apply(theme);
    try{localStorage.setItem('khata-theme',theme)}catch(e){}
  });
  /* Finds each screenshot in the same folder, whatever the extension */
  var E=['jpeg','jpg','png','webp','JPEG','JPG','PNG'];
  document.querySelectorAll('img[data-n]').forEach(function(img){
    var c=[],i=0;
    img.dataset.n.split(',').forEach(function(n){E.forEach(function(e){c.push(n+'.'+e)})});
    img.onerror=function(){
      if(i<c.length){img.src=c[i++]}
      else{img.onerror=null;img.removeAttribute('src');img.alt='Missing image: '+img.dataset.n+'.jpeg'}
    };
    img.onerror();
  });
})();
</script>
</body>
</html>
