<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#fbf3e4">
  <meta name="description" content="Khata is a private, offline money tracker for Android. No bank linking, no sign-up, no cloud.">
  <title>Khata — Your money. Your phone. Nobody else.</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Google+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      color-scheme: light;
      --bg: #fbf3e4;
      --bg-deep: #f3e2c4;
      --surface: rgba(255, 250, 240, .68);
      --surface-strong: rgba(255, 251, 242, .9);
      --ink: #2b1d14;
      --muted: #6e5847;
      --faint: #8d7662;
      --turmeric: #e3a21a;
      --turmeric-deep: #bf7b08;
      --chili: #b8432a;
      --jaggery: #8a5a2b;
      --line: rgba(98, 58, 24, .16);
      --line-bright: rgba(255, 255, 255, .76);
      --shadow: rgba(120, 70, 20, .16);
      --shadow-strong: rgba(91, 48, 12, .2);
      --sans: "Google Sans", "Product Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      --hand: "Caveat", "Segoe Script", cursive;
      --max: 1120px;
    }

    [data-theme="dark"] {
      color-scheme: dark;
      --bg: #17110d;
      --bg-deep: #241a13;
      --surface: rgba(60, 42, 30, .62);
      --surface-strong: rgba(48, 32, 22, .88);
      --ink: #f6e9d6;
      --muted: #bba48b;
      --faint: #9d846e;
      --turmeric: #f0b52a;
      --turmeric-deep: #e3a21a;
      --chili: #ef795b;
      --jaggery: #d59b61;
      --line: rgba(255, 226, 180, .15);
      --line-bright: rgba(255, 226, 180, .17);
      --shadow: rgba(0, 0, 0, .32);
      --shadow-strong: rgba(0, 0, 0, .5);
    }

    * { box-sizing: border-box; margin: 0; }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    body {
      min-width: 320px;
      overflow-x: hidden;
      color: var(--ink);
      background: var(--bg);
      font-family: var(--sans);
      line-height: 1.6;
      transition: background-color .35s ease, color .35s ease;
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(56vmax 48vmax at 0% 0%, rgba(227, 162, 26, .31), transparent 70%),
        radial-gradient(54vmax 46vmax at 100% 32%, rgba(184, 67, 42, .2), transparent 70%),
        radial-gradient(60vmax 50vmax at 22% 100%, rgba(138, 90, 43, .2), transparent 70%);
    }
    [data-theme="dark"] body::before {
      background:
        radial-gradient(56vmax 48vmax at 0% 0%, rgba(137, 83, 16, .24), transparent 70%),
        radial-gradient(54vmax 46vmax at 100% 32%, rgba(121, 47, 31, .2), transparent 70%),
        radial-gradient(60vmax 50vmax at 22% 100%, rgba(91, 58, 33, .24), transparent 70%);
    }
    a { color: inherit; }
    img { display: block; max-width: 100%; }
    button, a { -webkit-tap-highlight-color: transparent; }
    :focus-visible { outline: 3px solid var(--chili); outline-offset: 4px; }

    .skip-link {
      position: fixed;
      top: 12px;
      left: 12px;
      z-index: 100;
      padding: 10px 14px;
      color: #fff;
      background: var(--chili);
      border-radius: 999px;
      transform: translateY(-180%);
      transition: transform .2s ease;
    }
    .skip-link:focus { transform: translateY(0); }
    .wrap { width: min(var(--max), calc(100% - 36px)); margin-inline: auto; }
    .glass {
      background: var(--surface);
      border: 1px solid var(--line-bright);
      border-radius: 26px;
      box-shadow: inset 0 1px 0 var(--line-bright), 0 16px 38px var(--shadow);
      -webkit-backdrop-filter: blur(18px) saturate(1.35);
      backdrop-filter: blur(18px) saturate(1.35);
    }

    /* Navigation */
    nav { position: sticky; top: 12px; z-index: 20; padding-top: 12px; }
    nav .glass {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 8px 8px 8px 18px;
      border-radius: 999px;
    }
    .logo {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: var(--ink);
      font-size: 1.13rem;
      font-weight: 700;
      letter-spacing: -.03em;
      text-decoration: none;
    }
    .logo-mark {
      display: grid;
      width: 29px;
      height: 29px;
      place-items: center;
      color: #fff;
      background: linear-gradient(145deg, var(--turmeric), var(--chili));
      border-radius: 10px 10px 10px 4px;
      box-shadow: 0 5px 11px rgba(184, 67, 42, .25);
      transform: rotate(-8deg);
    }
    .logo-mark::after { content: "✦"; font-size: .9rem; transform: rotate(8deg); }
    .nav-r { display: flex; align-items: center; gap: 3px; }
    .nav-r a.l {
      display: none;
      padding: 8px 12px;
      color: var(--muted);
      font-size: .91rem;
      text-decoration: none;
      border-radius: 999px;
    }
    .nav-r a.l:hover { color: var(--ink); background: rgba(255, 255, 255, .2); }
    button.theme {
      color: var(--ink);
      font: inherit;
      font-size: .88rem;
      cursor: pointer;
      padding: 9px 15px;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 999px;
    }
    button.theme:hover { background: rgba(255, 255, 255, .2); }

    /* Buttons and type */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 50px;
      padding: 13px 22px;
      color: inherit;
      font-weight: 600;
      text-align: center;
      text-decoration: none;
      border-radius: 999px;
      transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    }
    .btn.main {
      color: #fff;
      background: linear-gradient(135deg, var(--turmeric), var(--chili));
      box-shadow: 0 11px 24px rgba(184, 67, 42, .28);
    }
    .btn.alt { background: var(--surface); border: 1px solid var(--line-bright); }
    .btn:hover { transform: translateY(-2px); }
    .btn:active { transform: translateY(0); }
    .cta { display: grid; gap: 10px; }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 11px;
      color: var(--chili);
      font-family: var(--hand);
      font-size: 1.65rem;
      line-height: 1;
    }
    [data-theme="dark"] .eyebrow { color: var(--turmeric); }
    h1, h2, h3 { text-wrap: balance; }
    h1 {
      max-width: 9.4ch;
      font-size: clamp(2.75rem, 11vw, 5.55rem);
      line-height: .98;
      letter-spacing: -.065em;
    }
    h2 {
      font-size: clamp(2rem, 5vw, 3.15rem);
      line-height: 1.05;
      letter-spacing: -.05em;
    }
    h3 { font-size: 1.16rem; line-height: 1.2; }
    .sub {
      max-width: 34em;
      margin: 20px 0 26px;
      color: var(--muted);
      font-size: clamp(1.02rem, 2vw, 1.12rem);
    }
    .lead { max-width: 37em; margin: 12px 0 26px; color: var(--muted); }

    /* Hero */
    .hero {
      display: grid;
      align-items: center;
      gap: 40px;
      padding: 68px 0 46px;
    }
    .hero-copy { position: relative; }
    .hero-copy::before {
      content: "";
      position: absolute;
      top: -22px;
      left: -26px;
      width: 78px;
      height: 78px;
      border-top: 2px solid var(--turmeric);
      border-left: 2px solid var(--turmeric);
      border-radius: 30px 0 0;
      opacity: .6;
    }
    .hero-note {
      display: inline-block;
      margin-top: 24px;
      padding: 6px 12px;
      color: var(--jaggery);
      font-family: var(--hand);
      font-size: 1.25rem;
      background: rgba(227, 162, 26, .11);
      border-left: 3px solid var(--turmeric);
      border-radius: 0 8px 8px 0;
    }
    [data-theme="dark"] .hero-note { color: var(--turmeric); }
    .phone {
      position: relative;
      width: min(286px, 78vw);
      justify-self: center;
      padding: 9px;
      border-radius: 40px;
      transform: rotate(3deg);
      box-shadow: 18px 25px 45px var(--shadow-strong);
    }
    .phone::before {
      content: "";
      position: absolute;
      top: 13px;
      left: 50%;
      z-index: 1;
      width: 74px;
      height: 17px;
      background: var(--ink);
      border-radius: 0 0 13px 13px;
      opacity: .9;
      transform: translateX(-50%);
    }

    /* Screenshot image slots */
    .pic {
      display: grid;
      width: 100%;
      aspect-ratio: 9 / 19.5;
      place-items: center;
      overflow: hidden;
      color: var(--muted);
      font-size: .78rem;
      text-align: center;
      background:
        linear-gradient(160deg, rgba(255, 255, 255, .34), transparent 44%),
        linear-gradient(145deg, var(--bg-deep), rgba(227, 162, 26, .12));
      border-radius: 31px;
      object-fit: cover;
    }
    .pic.is-fallback {
      align-content: center;
      gap: 10px;
      padding: 18px;
      border: 1px dashed var(--line);
    }
    .pic.is-fallback::before { content: "✦"; color: var(--turmeric); font-size: 1.8rem; }
    .pic.is-fallback::after { content: attr(data-label); max-width: 13ch; line-height: 1.35; }
    .phone .pic { border-radius: 33px; }

    /* Marquee */
    .mq { overflow: hidden; padding: 16px 0; margin: 8px 0; }
    .marquee {
      overflow: hidden;
      padding: 11px 0;
      background: var(--surface);
      border-block: 1px solid var(--line);
      transform: rotate(-1.2deg) scale(1.03);
    }
    .track { display: inline-flex; white-space: nowrap; animation: scroll 32s linear infinite; }
    .track span {
      padding: 0 24px;
      color: var(--jaggery);
      font-family: var(--hand);
      font-size: 1.85rem;
      font-weight: 700;
    }
    [data-theme="dark"] .track span { color: var(--turmeric); }
    .track span::after { content: "/"; margin-left: 48px; color: var(--chili); opacity: .72; }
    @keyframes scroll { to { transform: translateX(-50%); } }

    /* Content sections */
    section { padding: 62px 0; scroll-margin-top: 80px; }
    .section-kicker {
      margin-bottom: 7px;
      color: var(--chili);
      font-size: .8rem;
      font-weight: 700;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
    [data-theme="dark"] .section-kicker { color: var(--turmeric); }
    .shots {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      margin: 0 -18px;
      padding: 5px 18px 24px;
      scrollbar-width: none;
      scroll-snap-type: x mandatory;
    }
    .shots::-webkit-scrollbar { display: none; }
    .shot { flex: 0 0 67%; padding: 8px; scroll-snap-align: center; }
    .shot .pic { border-radius: 24px; }
    .shot figcaption { padding: 7px 0 1px; color: var(--jaggery); font-family: var(--hand); font-size: 1.48rem; text-align: center; }
    [data-theme="dark"] .shot figcaption { color: var(--turmeric); }
    .grid { display: grid; gap: 14px; }
    .card { padding: 23px; }
    .card h3 { margin-bottom: 7px; }
    .card p, .card li { color: var(--muted); font-size: .97rem; }
    .card ul { margin: 10px 0 0 18px; }
    .card li { margin: 6px 0; padding-left: 3px; }
    .card li::marker { color: var(--chili); }
    .feature-icon {
      display: grid;
      width: 36px;
      height: 36px;
      margin-bottom: 17px;
      place-items: center;
      color: var(--chili);
      background: rgba(227, 162, 26, .15);
      border-radius: 12px 12px 12px 4px;
    }
    [data-theme="dark"] .feature-icon { color: var(--turmeric); }
    .wide { grid-column: span 1; }
    .note {
      margin-top: 16px;
      padding: 11px 14px;
      color: var(--jaggery);
      font-family: var(--hand);
      font-size: 1.3rem;
      line-height: 1.24;
      background: rgba(227, 162, 26, .13);
      border-left: 3px solid var(--turmeric);
      border-radius: 0 8px 8px 0;
    }
    [data-theme="dark"] .note { color: var(--turmeric); }
    .final { margin: 10px 0 70px; padding: 48px 22px; text-align: center; }
    .final p { max-width: 30em; margin: 9px auto 24px; color: var(--muted); }
    footer { padding: 0 0 48px; color: var(--muted); font-size: .91rem; text-align: center; }
    footer a { display: inline-block; margin: 4px 10px; }
    footer a:hover { color: var(--chili); }
    footer p { margin-top: 11px; color: var(--faint); }

    @media (min-width: 620px) {
      .cta { display: flex; gap: 12px; }
      .btn { min-width: 160px; }
      .nav-r a.l { display: inline-block; }
      .shots { margin-inline: 0; padding-inline: 0; }
      .shot { flex-basis: 42%; }
      .grid.two { grid-template-columns: 1fr 1fr; }
    }
    @media (min-width: 820px) {
      .wrap { width: min(var(--max), calc(100% - 52px)); }
      .hero { grid-template-columns: minmax(0, 1.1fr) minmax(290px, .9fr); padding: 91px 0 62px; gap: 54px; }
      .hero-copy { padding-left: 10px; }
      .phone { width: min(300px, 100%); }
      .shots { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; overflow: visible; }
      .shot { flex-basis: auto; }
      .shot:nth-child(even) { margin-top: 30px; }
      .grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
      .wide { grid-column: span 2; }
      .final { padding: 58px 24px; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <nav aria-label="Primary navigation">
    <div class="glass wrap">
      <a class="logo" href="#top" aria-label="Khata home">
        <span class="logo-mark" aria-hidden="true"></span>
        <span>Khata</span>
      </a>
      <div class="nav-r">
        <a class="l" href="#screens">Screens</a>
        <a class="l" href="#features">Features</a>
        <a class="l" href="https://github.com/vijayarkananduri/khata" target="_blank" rel="noreferrer">GitHub</a>
        <button class="theme" id="theme" type="button" aria-label="Switch between light and dark theme">Dark</button>
      </div>
    </div>
  </nav>

  <main id="main-content">
    <section class="hero wrap" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <span class="eyebrow">the old ledger, now in your pocket</span>
        <h1 id="hero-title">Your money. Your phone. Nobody else.</h1>
        <p class="sub">Khata is a private, offline money tracker for Android. No bank linking, no sign-up, no cloud. You write the entries, the app keeps them, and nobody gets a copy.</p>
        <div class="cta">
          <a class="btn main" href="https://github.com/vijayarkananduri/khata/releases/latest" target="_blank" rel="noreferrer">Download the APK <span aria-hidden="true">↗</span></a>
          <a class="btn alt" href="https://github.com/vijayarkananduri/khata" target="_blank" rel="noreferrer">View on GitHub</a>
        </div>
        <span class="hero-note">Private by default. Offline by design.</span>
      </div>
      <div class="phone glass">
        <img class="pic" data-n="home" alt="Khata home screen">
      </div>
    </section>

    <div class="mq" aria-hidden="true">
      <div class="marquee"><div class="track">
        <span>no bank linking</span><span>works fully offline</span><span>no account needed</span><span>your data stays on your phone</span><span>nudges before you run out</span><span>five Indian languages</span>
        <span>no bank linking</span><span>works fully offline</span><span>no account needed</span><span>your data stays on your phone</span><span>nudges before you run out</span><span>five Indian languages</span>
      </div></div>
    </div>

    <section class="wrap" id="screens" aria-labelledby="screens-title">
      <p class="section-kicker">A quick look inside</p>
      <h2 id="screens-title">See where your money went</h2>
      <p class="lead">Four screens, nothing hidden. Swipe through them.</p>
      <div class="shots">
        <figure class="shot glass"><img class="pic" data-n="home" alt="Khata home screen"><figcaption>home</figcaption></figure>
        <figure class="shot glass"><img class="pic" data-n="calendar,calender" alt="Khata calendar and spending heatmap"><figcaption>calendar</figcaption></figure>
        <figure class="shot glass"><img class="pic" data-n="widget,widjet" alt="Khata home-screen widgets"><figcaption>widgets</figcaption></figure>
        <figure class="shot glass"><img class="pic" data-n="settings" alt="Khata settings screen"><figcaption>settings</figcaption></figure>
      </div>
    </section>

    <section class="wrap" id="features" aria-labelledby="features-title">
      <p class="section-kicker">Quietly useful</p>
      <h2 id="features-title">It tracks. That is the whole job.</h2>
      <p class="lead">Khata does a few things and does them quietly.</p>
      <div class="grid">
        <article class="card glass wide">
          <span class="feature-icon" aria-hidden="true">⌁</span>
          <h3>Nudges before you run out</h3>
          <p>Once Khata has seen you buy the same thing more than twice, it works out how often you buy it and reminds you when the next one is due. Milk, groceries, petrol, essentials. The maths happens on your phone, and you can switch nudges off in Settings.</p>
          <div class="note">A litre of milk lasts two days. On day two: “You may be running out of milk.”</div>
        </article>
        <article class="card glass"><span class="feature-icon" aria-hidden="true">▦</span><h3>Heatmap of your year</h3><p>A GitHub-style grid of your spending. Dark squares are the days your wallet had opinions.</p></article>
        <article class="card glass"><span class="feature-icon" aria-hidden="true">⌂</span><h3>Home-screen widgets</h3><p>Daily, weekly, monthly or all-time totals, and budget progress, without opening the app.</p></article>
        <article class="card glass"><span class="feature-icon" aria-hidden="true">अ</span><h3>Your language</h3><p>Hindi, Telugu, Tamil, Malayalam and Kannada, in the original script or in English letters.</p></article>
        <article class="card glass"><span class="feature-icon" aria-hidden="true">✦</span><h3>A bit of personality</h3><p>Short quotes inspired by movies and memes, because tracking money should not feel like a tax audit.</p></article>
        <article class="card glass"><span class="feature-icon" aria-hidden="true">◒</span><h3>Matches your phone</h3><p>Light, Dark, System, or colours pulled from your wallpaper. Export everything as CSV any time.</p></article>
      </div>
    </section>

    <section class="wrap" aria-label="Who Khata is for">
      <div class="grid two">
        <article class="card glass">
          <h3>Khata is for you if</h3>
          <ul>
            <li>You think your bank statement is none of an app's business</li>
            <li>You are happy to type in your own spending</li>
            <li>You want to see where money went, not be told how to invest it</li>
          </ul>
        </article>
        <article class="card glass">
          <h3>Khata is not for you if</h3>
          <ul>
            <li>You want expenses to appear automatically from your bank</li>
            <li>You want AI forecasts, scores or smart insights</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="final glass wrap" aria-labelledby="final-title">
      <h2 id="final-title">Open the book.</h2>
      <p>Install the APK, allow installs from your browser if Android asks, and start writing.</p>
      <a class="btn main" href="https://github.com/vijayarkananduri/khata/releases/latest" target="_blank" rel="noreferrer">Download the latest APK <span aria-hidden="true">↗</span></a>
    </section>
  </main>

  <footer class="wrap">
    <a href="https://github.com/vijayarkananduri/khata" target="_blank" rel="noreferrer">Source code</a>
    <a href="https://github.com/vijayarkananduri/khata/releases" target="_blank" rel="noreferrer">Releases</a>
    <a href="https://github.com/vijayarkananduri/khata/issues" target="_blank" rel="noreferrer">Report a bug</a>
    <p>Built with Kotlin, Jetpack Compose and Room.</p>
  </footer>

  <script>
    (() => {
      const root = document.documentElement;
      const themeButton = document.getElementById('theme');
      const metaTheme = document.querySelector('meta[name="theme-color"]');
      const storageKey = 'khata-theme';
      const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      let theme = null;
      try { theme = localStorage.getItem(storageKey); } catch (error) { /* localStorage may be blocked */ }

      function applyTheme(nextTheme) {
        theme = nextTheme;
        root.setAttribute('data-theme', nextTheme);
        themeButton.textContent = nextTheme === 'dark' ? 'Light' : 'Dark';
        themeButton.setAttribute('aria-label', `Switch to ${nextTheme === 'dark' ? 'light' : 'dark'} theme`);
        if (metaTheme) metaTheme.setAttribute('content', nextTheme === 'dark' ? '#17110d' : '#fbf3e4');
      }
      applyTheme(theme || (prefersDark ? 'dark' : 'light'));
      themeButton.addEventListener('click', () => {
        const nextTheme = theme === 'dark' ? 'light' : 'dark';
        applyTheme(nextTheme);
        try { localStorage.setItem(storageKey, nextTheme); } catch (error) { /* keep working without persistence */ }
      });

      // Look for supplied screenshots in the same folder, whatever their extension.
      const extensions = ['jpeg', 'jpg', 'png', 'webp', 'JPEG', 'JPG', 'PNG'];
      document.querySelectorAll('img[data-n]').forEach((image) => {
        const candidates = [];
        image.dataset.n.split(',').forEach((name) => extensions.forEach((extension) => candidates.push(`${name}.${extension}`)));
        let index = 0;
        const showFallback = () => {
          const fallback = document.createElement('div');
          fallback.className = 'pic is-fallback';
          fallback.setAttribute('role', 'img');
          fallback.setAttribute('aria-label', image.alt);
          fallback.setAttribute('data-label', image.alt);
          image.replaceWith(fallback);
        };
        image.addEventListener('error', () => {
          if (index < candidates.length) image.src = candidates[index++];
          else showFallback();
        });
        image.src = candidates[index++];
      });
    })();
  </script>
</body>
</html>
